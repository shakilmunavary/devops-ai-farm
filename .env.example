# AI MCP Server Kit Configuration

# Web App Port
FLASK_PORT=5000
FLASK_HOST=0.0.0.0
FLASK_DEBUG=False

# MCP Gateway Port & Path
GATEWAY_PORT=5001
# Path to agentgateway executable if not in PATH (e.g. C:\tools\agentgateway.exe)
GATEWAY_BINARY=agentgateway

# Optional: Mistral API Key for Conversational Builder
# If not provided, the app uses its intelligent built-in slot-filling assistant
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
